# PostgreSQL 연결 정보
DATABASE_URL="postgresql://postgres:password@localhost:5432/jonggapredict?schema=public"

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# 포인트 정책 (기획 확정 시 이 값들로 운영, 코드 수정 없이 조정 가능하도록 이후 DB 설정값으로 옮겨도 됨)
SIGNUP_BONUS_POINTS=300
REFERRAL_NEW_BONUS_POINTS=200
REFERRAL_EXISTING_BONUS_POINTS=300
ATTEND_DAILY_POINT=10
ATTEND_WEEKLY_BONUS=50
ATTEND_MONTHLY_BONUS=300

# 토스증권 Open API (무료 - 토스증권 WTS 로그인 > 설정 > Open API 에서 발급)
# 둘 다 채워지면 자동으로 실제 시세를 쓰고, 비어있으면 개발용 Mock 시세를 사용합니다.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# 난이도별 베팅 제한 (하루 최대 횟수 + 마지막 베팅 후 대기 시간)
BET_DAILY_LIMIT=3
BET_COOLDOWN_HOURS=8

PORT=4000
